# Any OpenAI-compatible endpoint is supported.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=
AI_MAX_ITERATIONS=12
AI_MAX_TOOL_CALLS=80

# Run against the current repository by default.
AGENT_WORKSPACE=.
AGENT_TIMEOUT_MS=120000
AGENT_COMMAND_POLICY=strict

# Optional GitHub automation
GITHUB_TOKEN=
GITHUB_REPOSITORY=
